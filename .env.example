# ---- Database (Neon) ----
# 运行时连接：注意 host 里带 -pooler
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Prisma migrate 用直连：host 不带 -pooler
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ---- Auth ----
# 生成方式：openssl rand -base64 32
JWT_SECRET="replace-me-with-a-random-32-byte-secret"
JWT_EXPIRES_IN="7d"

# ---- LLM (续费沟通简报) ----
# 任意 provider 均可，调用量极小。缺失时简报功能自动降级，其余功能不受影响
LLM_API_KEY=""
LLM_MODEL="claude-sonnet-5"
LLM_TIMEOUT_MS="8000"

# ---- App ----
PORT="3000"
NODE_ENV="development"
# 业务时区固定，不做多时区切换
BUSINESS_TIMEZONE="Australia/Melbourne"
