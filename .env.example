# ---- Database (Neon) ----
# 运行时连接：注意 host 里带 -pooler
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Prisma migrate 用直连：host 不带 -pooler
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"
# migrate dev 需要 shadow database，Neon 不允许 Prisma 自动创建，需先手动建库：
#   psql "$DATABASE_URL_UNPOOLED" -c 'CREATE DATABASE shadow_db;'
# 然后把上面的直连串里的 /neondb 换成 /shadow_db 填在这里
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/shadow_db?sslmode=require"

# ---- Auth ----
# 生成方式：openssl rand -base64 32
JWT_SECRET="replace-me-with-a-random-32-byte-secret"
JWT_EXPIRES_IN="7d"

# ---- LLM (续费沟通简报) ----
# 任意 provider 均可，调用量极小。缺失时简报功能自动降级，其余功能不受影响
QIANWEN_API_KEY=""
QIANWEN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
QIANWEN_MODEL_NAME="qwen-plus"
LLM_TIMEOUT_MS="8000"

# ---- App ----
PORT="3000"
NODE_ENV="development"
# 业务时区固定，不做多时区切换
BUSINESS_TIMEZONE="Australia/Melbourne"
